<Project Sdk="{{ProjectSdk}}">

  <PropertyGroup>
    <TiaVersion>{{TiaVersion}}</TiaVersion>
    <TiaPortalLocation Condition="'$(TiaPortalLocation)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Siemens\Automation\_InstalledSW\TIAP$(TiaVersion)\Global', 'Path', '', RegistryView.Registry64, RegistryView.Registry32))</TiaPortalLocation>
    <TiaAddInApiPath>$(TiaPortalLocation)\PublicAPI\V$(TiaVersion)\net48</TiaAddInApiPath>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>{{OutputType}}</OutputType>
    <RootNamespace>{{RootNamespace}}</RootNamespace>
    <AssemblyName>{{ProjectName}}</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Product>{{ProductName}}</Product>
    <Company>{{Company}}</Company>
    <Copyright>{{Copyright}}</Copyright>
    <Description>{{Description}}</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PlatformTarget>x64</PlatformTarget>
{{UiFrameworkProperties}}
  </PropertyGroup>

  <Target Name="ValidateTiaPortalLocation" BeforeTargets="BeforeResolveReferences">
    <Error Condition="'$(TiaPortalLocation)' == ''"
           Text="TIA Portal V$(TiaVersion) was not found. Registry key HKLM\SOFTWARE\Siemens\Automation\_InstalledSW\TIAP$(TiaVersion)\Global could not be read. Set the TiaPortalLocation property manually." />
    <Error Condition="!Exists('$(TiaAddInApiPath)')"
           Text="The Openness API folder was not found: $(TiaAddInApiPath)" />
    <Message Text="TiaPortalLocation = $(TiaPortalLocation)" Importance="high" />
  </Target>

  <!-- The Openness assemblies are NOT copied to the output directory. They are loaded at
       runtime from the TIA Portal installation through the AssemblyResolve handler in
       Program.cs. The resolved directory is written into the app config below. -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaAddInApiPath)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
{{AdditionalEngineeringReferences}}
  </ItemGroup>

</Project>
